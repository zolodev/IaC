metadata_dir = "{{ garage_data_dir }}/meta"
data_dir     = "{{ garage_data_dir }}/data"
db_engine    = "lmdb"

# Auto-derived from the [garage] inventory group so this always matches the
# real cluster size — 1 for a lone node, 2 once zyron+nova both run Garage.
replication_factor = {{ groups['garage'] | length }}

rpc_bind_addr    = "{{ garage_rpc_bind }}"
# ansible_default_ipv4.address is the wrong choice here — it's whatever
# interface holds the default route, which for a home LAN box (zyron) is
# its LAN IP and for a remote VPS (nova) is its *public internet* IP.
# Neither is reachable from the other node directly. k3s_node_ip is each
# host's Tailscale overlay address, already the proven-working address
# space for cross-node traffic between exactly these hosts (see prod.ini).
rpc_public_addr  = "{{ k3s_node_ip | default(ansible_host) }}:3901"
rpc_secret       = "{{ vault_garage_rpc_secret }}"

[s3_api]
s3_region        = "{{ garage_region }}"
api_bind_addr    = "{{ garage_s3_bind }}"

[s3_web]
bind_addr = "0.0.0.0:3902"
root_domain = ".web.garage.local"
index = "index.html"
